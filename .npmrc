# npm configuration for more-or-less-admin.
#
# npm is the sole supported package manager for this repository. The exact npm
# version is pinned in package.json via the `packageManager` field, matching the
# npm shipped with the Node 22 LTS line this repo builds on (Workers Builds and
# CI both use Node 22).
#
# ---------------------------------------------------------------------------
# Install-time (native) build approvals
# ---------------------------------------------------------------------------
# The removed pnpm-workspace.yaml carried an `allowBuilds` list approving
# install-time builds for exactly four packages:
#
#   { '@firebase/util': true, esbuild: true, protobufjs: true, workerd: true }
#
# npm has no per-package build allowlist equivalent to pnpm's `allowBuilds`:
# dependency lifecycle scripts are either enabled for every dependency or
# disabled for every dependency, via `ignore-scripts`. The setting at the
# bottom of this file is therefore the npm equivalent of that approval, and it
# is recorded explicitly here (rather than left implicit in npm's default) so
# the approval is a real, reviewable artifact.
#
# Determination for each previously approved package, verified against the
# installed tree (node_modules/<pkg>/package.json `scripts`):
#
#   @firebase/util  1.15.3          postinstall: node ./postinstall.js
#                                   -> lifecycle build REQUIRED
#   esbuild         0.25.12         postinstall: node install.js
#                                   -> lifecycle build REQUIRED (resolves and
#                                      links the platform esbuild binary)
#   protobufjs      7.6.6           postinstall: node scripts/postinstall
#                                   -> lifecycle build REQUIRED
#   workerd         1.20260903.1    postinstall: node install.js
#                                   -> lifecycle build REQUIRED (links the
#                                      platform workerd binary used by
#                                      wrangler / the Cloudflare vite plugin)
#
# All four still run an install-time script under npm, so none of them is a
# "no lifecycle build needed under npm" case. Setting ignore-scripts=true would
# leave esbuild and workerd without their platform binaries and break
# `npm run build` and `wrangler deploy`.
ignore-scripts=false
