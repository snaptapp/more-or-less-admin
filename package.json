{
  "name": "custom_design_system_tanstack",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite dev",
    "gate": "node scripts/quality-gate.mjs",
    "build": "node scripts/quality-gate.mjs && vite build",
    "build:dev": "node scripts/quality-gate.mjs && vite build --mode development",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:version": "npm run build && wrangler versions upload",
    "cf-typegen": "wrangler types",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint .",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:contract-literals": "node scripts/check-contract-literals.mjs",
    "check:contract": "node scripts/check-contract-drift.mjs",
    "check:artifacts": "node scripts/check-shared-artifacts.mjs",
    "check:artifact-freshness": "node scripts/check-artifact-freshness.mjs",
    "sync:artifacts": "node scripts/sync-shared-artifacts.mjs",
    "sync:shared-artifacts": "node scripts/sync-shared-artifacts.mjs",
    "sync:contract": "node scripts/sync-contract-source.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "4.10.1",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.1",
    "wrangler": "^4.127.1"
  }
}
