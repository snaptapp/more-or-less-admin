# Local Vite env. Copy to .env (gitignored). Worker production uses wrangler
# vars / secrets, not this file.
#
# FIREBASE_WEB_API_KEY is the publishable Firebase web key (browser sign-in).
# ADMIN_EMAIL_ALLOWLIST can also be a Worker secret of the same name.
# FIREBASE_SERVICE_ACCOUNT_JSON is a Worker secret only. Never put it here.

FIREBASE_PROJECT_ID=more-or-less-505908
GOOGLE_CLOUD_PROJECT=more-or-less-505908
FIREBASE_WEB_API_KEY=
ADMIN_EMAIL_ALLOWLIST=
GO_AGENT_URL=
# Non-secret base URL of the game Worker used for read-only bank observability.
GAME_WORKER_URL=https://more-or-less.trackdub.workers.dev
VERTEX_LOCATION=global
OPS_CHAT_BACKEND=gemini
# Optional HTTP ADK complete() endpoint. Empty means adk is CLI-only.
OPS_STRATEGIST_URL=
# Secret for POST /api/internal/daily-drafts (autonomous drafts, never live publish).
OPS_CRON_SECRET=
# Secret for GET /api/internal/ops/factbank/* (Notion Ops Assistant).
OPS_ASSISTANT_SECRET=
# Local/bootstrap only: allow OPS_CRON_SECRET when OPS_ASSISTANT_SECRET is unset (never in production).
# OPS_ASSISTANT_ALLOW_CRON_FALLBACK=1
PORT=3000
